{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": "./app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_date": "2026-07-31",
  "kv_namespaces": [
    {
      "binding": "data",
      "id": "17bef60b14ed4c02ad607ddd2aac18c4",
      "preview_id": "d69ca07021724fdfb3d758c07c487ce7"
    }
  ],
  "limits": {
    "cpu_ms": 100
  },
  "main": "src/index.ts",
  "minify": true,
  "name": "dtiktok",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 10
      }
    }
  ],
  "vars": {
    "MAINTENANCE": false
  },
  "workers_dev": false
}
